{
  "name": "chatgpt-uk-business-checker",
  "version": "1.0.0",
  "description": "ChatGPT App for UK business verification and due diligence using Companies House API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:react-widgets && npm run build:server",
    "build:server": "tsc",
    "build:react-widgets": "cd web && npm install && npm run build",
    "build:widgets": "node scripts/build-widgets.js",
    "dev": "tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node dist/server.js"
  },
  "keywords": [
    "chatgpt",
    "chatgpt-apps",
    "mcp",
    "model-context-protocol",
    "companies-house",
    "uk-business",
    "due-diligence",
    "fraud-prevention",
    "business-verification"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
