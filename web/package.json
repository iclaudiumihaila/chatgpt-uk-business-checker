{
  "name": "uk-business-checker-widgets",
  "version": "1.0.0",
  "description": "React widgets for UK Business Due Diligence Checker ChatGPT App",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:search && npm run build:verify",
    "build:search": "esbuild src/search-carousel.tsx --bundle --format=iife --outfile=dist/search-carousel.js --minify --global-name=SearchCarousel",
    "build:verify": "esbuild src/company-card.tsx --bundle --format=iife --outfile=dist/company-card.js --minify --global-name=CompanyCard",
    "watch": "npm run build:search -- --watch & npm run build:verify -- --watch"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.6.0"
  }
}
